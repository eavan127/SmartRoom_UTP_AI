# Privacy: never commit faces, ID photos, embeddings or trained models
# Only the folder layout (README.md, .gitkeep) under data/ is tracked
data/**
!data/**/
!data/**/README.md
!data/**/.gitkeep
*.jpg
*.jpeg
*.heic
prototype/local_gallery.js
smartroom-faces*.json
models/
outputs/
logs/
*.npz
*.pt
*.pth
*.onnx

# Python
__pycache__/
*.pyc
.venv/
venv/
.streamlit/secrets.toml
